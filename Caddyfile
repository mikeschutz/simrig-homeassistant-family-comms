# Example only. Merge with your own TLS, routing, and access policy.
# Replace the hostname, file root, and broker upstream.
# The broker's credentials/ACLs authenticate MQTT clients, not this static page.
rig-messages.example.com {
    redir /overlay /overlay/ 308

    handle_path /overlay/* {
        root * /srv/simrig-overlay
        header {
            Cache-Control "no-store"
            Referrer-Policy "no-referrer"
            X-Content-Type-Options "nosniff"
            Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; worker-src 'self' blob:; connect-src 'self' wss://rig-messages.example.com; object-src 'none'; base-uri 'self'"
        }
        file_server
    }

    # Preserve /mqtt on its way to Mosquitto's WebSocket listener.
    handle /mqtt {
        reverse_proxy mqtt-broker:9001
    }

    handle {
        respond "Not found" 404
    }
}
